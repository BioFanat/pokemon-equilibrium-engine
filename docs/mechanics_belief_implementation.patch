+                        if obs2.compatible(h_last, 101):
+                            brute[h_last] = brute.get(h_last, 0) + ph * pd1 * pd2
+        self.assertAlmostEqual(p1 * p2, sum(brute.values()))
+        self.assertEqual(h2, {h: p / sum(brute.values()) for h, p in brute.items()})
